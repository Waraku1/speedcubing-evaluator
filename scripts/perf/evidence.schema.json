{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hca.invalid/schemas/rc-performance-evidence-v1.json",
  "title": "HCA RC performance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSha", "artifact", "timestamp", "environment", "measurements"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildId", "buildCommand", "release"],
      "properties": {
        "buildId": { "type": "string", "minLength": 1 },
        "buildCommand": { "const": "pnpm build" },
        "release": { "const": "2026-09-10-rc" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "required": ["os", "architecture", "node", "pnpm", "hostClass", "evidenceClass"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "node": { "type": "string" },
        "pnpm": { "type": "string" },
        "browser": { "type": "string" },
        "browserVersion": { "type": "string" },
        "hostClass": { "type": "string" },
        "evidenceClass": { "enum": ["LOCAL_BASELINE", "CI_MEASURED", "TARGET_HOST", "PHYSICAL_DEVICE"] }
      }
    },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurement" }
    }
  },
  "$defs": {
    "summary": {
      "type": ["object", "null"],
      "properties": {
        "min": { "type": "number" },
        "p50": { "type": "number" },
        "p75": { "type": "number" },
        "p95": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["measurementId", "pbGateId", "scenario", "sampleCount", "warmupCount", "rawSamples", "units", "summary", "failures", "threshold", "decision", "notes"],
      "properties": {
        "measurementId": { "type": "string", "minLength": 1 },
        "pbGateId": { "enum": ["PB-01", "PB-02", "PB-03", "PB-04", "PB-05", "PB-06", "PB-07", "PB-08", "PB-09", "PB-10", "PB-11", "PB-12", "PB-13", "PB-14", "PB-15", "PB-16", "PB-17", "PB-18", "PB-19"] },
        "scenario": { "type": "string", "minLength": 1 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "warmupCount": { "type": "integer", "minimum": 0 },
        "rawSamples": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "units": { "enum": ["milliseconds", "bytes", "count", "ratio", "kibibytes"] },
        "summary": { "$ref": "#/$defs/summary" },
        "failures": { "type": "array" },
        "threshold": { "type": "array" },
        "decision": { "enum": ["PASS_MEASURED", "FAIL_MEASURED", "HARNESS_READY_TARGET_HOST_REQUIRED", "HARNESS_READY_PHYSICAL_DEVICE_REQUIRED", "NOT_APPLICABLE_TO_THIS_INCREMENT"] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array" },
        "memory": { "type": "object" }
      }
    }
  }
}
